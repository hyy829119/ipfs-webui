# Local development. Copy to .env; the API does not read this file automatically.
# Run: node --env-file=ipfs-webuiapi/.env ipfs-webuiapi/server.mjs
WEBUI_API_HOST=127.0.0.1
WEBUI_API_PORT=3001
# Absolute paths are recommended for production.
# WEBUI_API_DB=/var/lib/ifshare-webuiapi/ifshare.sqlite
# WEBUI_STATIC_DIR=/opt/ifshare/current/web
# Required behind a public HTTPS reverse proxy, without a trailing path.
# WEBUI_API_PUBLIC_ORIGIN=https://files.example.com
KUBO_RPC_URL=http://127.0.0.1:5001
KUBO_GATEWAY_URL=http://127.0.0.1:8080

# Storage backend: sqlite (default), mysql, mariadb or postgresql.
WEBUI_API_DB_TYPE=sqlite
# External database example; install drivers with npm ci --prefix ipfs-webuiapi.
# WEBUI_API_DB_HOST=127.0.0.1
# WEBUI_API_DB_PORT=3306
# WEBUI_API_DB_NAME=ifshare
# WEBUI_API_DB_USER=ifshare
# WEBUI_API_DB_PASSWORD=replace-with-database-password
# PostgreSQL uses port 5432 by default. mysql/mariadb use 3306.
# Create a missing database automatically (requires CREATE privilege).
# WEBUI_API_DB_CREATE=true
# WEBUI_API_DB_POOL_SIZE=10
# Enable certificate verification for remote TLS database connections.
# WEBUI_API_DB_SSL=true
# WEBUI_API_DB_CA=/etc/ifshare/database-ca.pem

# Bound metadata/API work independently from large file transfers.
# WEBUI_API_DB_QUERY_TIMEOUT_MS=15000
# WEBUI_API_DB_ACQUIRE_TIMEOUT_MS=10000
# WEBUI_API_DB_QUEUE_LIMIT=100
# WEBUI_API_BODY_TIMEOUT_MS=15000
# JSON runtime diagnostics; does not disable file operation records.
# WEBUI_API_LOG_LEVEL=info
